# Copy to .env.staging and replace every CHANGE_ME value.
# Never commit .env.staging.

CONFIRM_STAGING=revenda-smart-staging-CHANGE_ME
STAGING_PROJECT_ID=revenda-smart-staging-CHANGE_ME
STAGING_REGION=us-central1
STAGING_SERVICE=revendasmart-backend-staging
STAGING_VERCEL_PROJECT=revendasmart-staging
STAGING_RUNTIME_SERVICE_ACCOUNT=revendasmart-staging-backend@revenda-smart-staging-CHANGE_ME.iam.gserviceaccount.com
STAGING_FRONTEND_URL=https://revendasmart-staging-CHANGE_ME.vercel.app
STAGING_BACKEND_URL=https://revendasmart-backend-staging-CHANGE_ME.run.app

VITE_FIREBASE_API_KEY=CHANGE_ME
VITE_FIREBASE_AUTH_DOMAIN=revenda-smart-staging-CHANGE_ME.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=revenda-smart-staging-CHANGE_ME
VITE_FIREBASE_STORAGE_BUCKET=revenda-smart-staging-CHANGE_ME.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
VITE_FIREBASE_APP_ID=CHANGE_ME
VITE_API_BASE_URL=https://revendasmart-backend-staging-CHANGE_ME.run.app
VITE_PUBLIC_APP_URL=https://revendasmart.vercel.app

NODE_ENV=staging
PORT=8080
FIREBASE_PROJECT_ID=revenda-smart-staging-CHANGE_ME
FRONTEND_URL=https://revendasmart-staging-CHANGE_ME.vercel.app
APP_BASE_URL=https://revendasmart-backend-staging-CHANGE_ME.run.app
MERCADOPAGO_REDIRECT_URI=https://revendasmart-backend-staging-CHANGE_ME.run.app/api/mercadopago/callback
PREMIUM_PRICE_BRL=19.90
# PLAN-IMPL-04B: Pro e Premium v2 (novo, genérico) — desativados por padrão (fail-closed). Reusam o
# mesmo MERCADOPAGO_ACCESS_TOKEN_SECRET acima; não precisam de um segredo de provider separado.
PRO_SUBSCRIPTION_ENABLED=false
PRO_PRICE_BRL_CENTS=4990
PREMIUM_V2_SUBSCRIPTION_ENABLED=false
PREMIUM_V2_PRICE_BRL_CENTS=7990
ALLOW_UNSIGNED_SUBSCRIPTION_WEBHOOK=false

FIREBASE_CLIENT_EMAIL_SECRET=revendasmart-staging-firebase-client-email
FIREBASE_PRIVATE_KEY_SECRET=revendasmart-staging-firebase-private-key
MERCADOPAGO_ACCESS_TOKEN_SECRET=revendasmart-staging-mp-access-token
MERCADOPAGO_CLIENT_ID_SECRET=revendasmart-staging-mp-client-id
MERCADOPAGO_CLIENT_SECRET_SECRET=revendasmart-staging-mp-client-secret
MERCADOPAGO_TOKEN_ENCRYPTION_KEY_SECRET=revendasmart-staging-mp-token-encryption-key
MERCADOPAGO_WEBHOOK_SECRET_SECRET=revendasmart-staging-mp-webhook-secret

QA_EMAIL=homologacao@revendasmart.test
QA_STORE_NAME="Loja QA RevendaSmart"
QA_CATALOG_SLUG=loja-qa-revendasmart
