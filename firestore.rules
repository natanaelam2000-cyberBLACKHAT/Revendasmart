rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== HELPER FUNCTIONS =====
    
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function userOwnsResource(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }

    function productAllowedFields() {
      return [
        'id', 'name', 'brand', 'origin', 'category', 'productType',
        'costPrice', 'salePrice', 'stock', 'barcode', 'description',
        'imageUrl', 'storagePath', 'imageId', 'photoUrl', 'image', 'photo',
        'gender', 'lastSoldDate', 'extras', 'isFeatured', 'isOnSale',
        'discountPercent', 'discount', 'promotionalPrice', 'createdAt', 'updatedAt',
        'nameNormalized', 'brandNormalized', 'categoryNormalized',
        'barcodeNormalized', 'productTypeNormalized', 'searchTokens',
        'searchSchemaVersion'
      ];
    }

    function isValidProductCreate(productId) {
      return request.resource.data.keys().hasOnly(productAllowedFields())
        && request.resource.data.keys().hasAll(['name', 'salePrice'])
        && request.resource.data.get('id', productId) == productId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 180
        && request.resource.data.salePrice is number
        && request.resource.data.salePrice > 0
        && request.resource.data.salePrice <= 1000000
        && request.resource.data.get('costPrice', 0) is number
        && request.resource.data.get('costPrice', 0) >= 0
        && request.resource.data.get('costPrice', 0) <= 1000000
        && request.resource.data.get('stock', 0) is number
        && request.resource.data.get('stock', 0) >= 0
        && request.resource.data.get('stock', 0) <= 1000000
        && request.resource.data.get('brand', '') is string
        && request.resource.data.get('brand', '').size() <= 100
        && request.resource.data.get('origin', '') is string
        && request.resource.data.get('origin', '').size() <= 80
        && request.resource.data.get('category', '') is string
        && request.resource.data.get('category', '').size() <= 100
        && request.resource.data.get('productType', '') is string
        && request.resource.data.get('productType', '').size() <= 80
        && request.resource.data.get('barcode', '') is string
        && request.resource.data.get('barcode', '').size() <= 80
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 2000
        && request.resource.data.get('imageUrl', '') is string
        && request.resource.data.get('imageUrl', '').size() <= 2000
        && request.resource.data.get('storagePath', '') is string
        && request.resource.data.get('storagePath', '').size() <= 1000
        && request.resource.data.get('imageId', '') is string
        && request.resource.data.get('imageId', '').size() <= 200
        && request.resource.data.get('photoUrl', '') is string
        && request.resource.data.get('photoUrl', '').size() <= 2000
        && request.resource.data.get('image', '') is string
        && request.resource.data.get('image', '').size() <= 2000
        && request.resource.data.get('photo', '') is string
        && request.resource.data.get('photo', '').size() <= 2000
        && request.resource.data.get('gender', '') is string
        && request.resource.data.get('gender', '').size() <= 40
        && request.resource.data.get('lastSoldDate', '') is string
        && request.resource.data.get('lastSoldDate', '').size() <= 80
        && request.resource.data.get('extras', {}) is map
        && request.resource.data.get('isFeatured', false) is bool
        && request.resource.data.get('isOnSale', false) is bool
        && request.resource.data.get('discountPercent', 0) is number
        && request.resource.data.get('discountPercent', 0) >= 0
        && request.resource.data.get('discountPercent', 0) <= 100
        && request.resource.data.get('discount', 0) is number
        && request.resource.data.get('discount', 0) >= 0
        && request.resource.data.get('promotionalPrice', 0) is number
        && request.resource.data.get('promotionalPrice', 0) >= 0
        && request.resource.data.get('nameNormalized', '') is string
        && request.resource.data.get('nameNormalized', '').size() <= 180
        && request.resource.data.get('brandNormalized', '') is string
        && request.resource.data.get('brandNormalized', '').size() <= 120
        && request.resource.data.get('categoryNormalized', '') is string
        && request.resource.data.get('categoryNormalized', '').size() <= 120
        && request.resource.data.get('barcodeNormalized', '') is string
        && request.resource.data.get('barcodeNormalized', '').size() <= 100
        && request.resource.data.get('productTypeNormalized', '') is string
        && request.resource.data.get('productTypeNormalized', '').size() <= 100
        && request.resource.data.get('searchTokens', []) is list
        && request.resource.data.get('searchTokens', []).size() <= 16
        && request.resource.data.get('searchSchemaVersion', 0) is number
        && request.resource.data.get('searchSchemaVersion', 0) >= 0
        && request.resource.data.get('searchSchemaVersion', 0) <= 10;
    }

    function isValidProductUpdate(productId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(productAllowedFields())
        && (!changed.hasAny(['id']) || request.resource.data.get('id', productId) == productId)
        && (!changed.hasAny(['name']) || (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 180))
        && (!changed.hasAny(['salePrice']) || (request.resource.data.salePrice is number && request.resource.data.salePrice > 0 && request.resource.data.salePrice <= 1000000))
        && (!changed.hasAny(['costPrice']) || (request.resource.data.costPrice is number && request.resource.data.costPrice >= 0 && request.resource.data.costPrice <= 1000000))
        && (!changed.hasAny(['stock']) || (request.resource.data.stock is number && request.resource.data.stock >= 0 && request.resource.data.stock <= 1000000))
        && (!changed.hasAny(['brand']) || (request.resource.data.brand is string && request.resource.data.brand.size() <= 100))
        && (!changed.hasAny(['origin']) || (request.resource.data.origin is string && request.resource.data.origin.size() <= 80))
        && (!changed.hasAny(['category']) || (request.resource.data.category is string && request.resource.data.category.size() <= 100))
        && (!changed.hasAny(['productType']) || (request.resource.data.productType is string && request.resource.data.productType.size() <= 80))
        && (!changed.hasAny(['barcode']) || (request.resource.data.barcode is string && request.resource.data.barcode.size() <= 80))
        && (!changed.hasAny(['description']) || (request.resource.data.description is string && request.resource.data.description.size() <= 2000))
        && (!changed.hasAny(['imageUrl']) || (request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 2000))
        && (!changed.hasAny(['storagePath']) || (request.resource.data.storagePath is string && request.resource.data.storagePath.size() <= 1000))
        && (!changed.hasAny(['imageId']) || (request.resource.data.imageId is string && request.resource.data.imageId.size() <= 200))
        && (!changed.hasAny(['photoUrl']) || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2000))
        && (!changed.hasAny(['image']) || (request.resource.data.image is string && request.resource.data.image.size() <= 2000))
        && (!changed.hasAny(['photo']) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 2000))
        && (!changed.hasAny(['gender']) || (request.resource.data.gender is string && request.resource.data.gender.size() <= 40))
        && (!changed.hasAny(['lastSoldDate']) || (request.resource.data.lastSoldDate is string && request.resource.data.lastSoldDate.size() <= 80))
        && (!changed.hasAny(['extras']) || request.resource.data.extras is map)
        && (!changed.hasAny(['isFeatured']) || request.resource.data.isFeatured is bool)
        && (!changed.hasAny(['isOnSale']) || request.resource.data.isOnSale is bool)
        && (!changed.hasAny(['discountPercent']) || (request.resource.data.discountPercent is number && request.resource.data.discountPercent >= 0 && request.resource.data.discountPercent <= 100))
        && (!changed.hasAny(['discount']) || (request.resource.data.discount is number && request.resource.data.discount >= 0))
        && (!changed.hasAny(['promotionalPrice']) || (request.resource.data.promotionalPrice is number && request.resource.data.promotionalPrice >= 0))
        && (!changed.hasAny(['nameNormalized']) || (request.resource.data.nameNormalized is string && request.resource.data.nameNormalized.size() <= 180))
        && (!changed.hasAny(['brandNormalized']) || (request.resource.data.brandNormalized is string && request.resource.data.brandNormalized.size() <= 120))
        && (!changed.hasAny(['categoryNormalized']) || (request.resource.data.categoryNormalized is string && request.resource.data.categoryNormalized.size() <= 120))
        && (!changed.hasAny(['barcodeNormalized']) || (request.resource.data.barcodeNormalized is string && request.resource.data.barcodeNormalized.size() <= 100))
        && (!changed.hasAny(['productTypeNormalized']) || (request.resource.data.productTypeNormalized is string && request.resource.data.productTypeNormalized.size() <= 100))
        && (!changed.hasAny(['searchTokens']) || (request.resource.data.searchTokens is list && request.resource.data.searchTokens.size() <= 16))
        && (!changed.hasAny(['searchSchemaVersion']) || (request.resource.data.searchSchemaVersion is number && request.resource.data.searchSchemaVersion >= 0 && request.resource.data.searchSchemaVersion <= 10));
    }

    function clientAllowedFields() {
      return [
        'id', 'name', 'phone', 'whatsapp', 'email', 'notes',
        'createdAt', 'updatedAt', 'lastPurchaseAt', 'totalSpent', 'purchaseCount'
      ];
    }

    function isValidClientCreate(clientId) {
      return request.resource.data.keys().hasOnly(clientAllowedFields())
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.get('id', clientId) == clientId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 140
        && request.resource.data.get('phone', '') is string
        && request.resource.data.get('phone', '').size() <= 40
        && request.resource.data.get('whatsapp', '') is string
        && request.resource.data.get('whatsapp', '').size() <= 40
        && request.resource.data.get('email', '') is string
        && request.resource.data.get('email', '').size() <= 180
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 2000
        && request.resource.data.get('totalSpent', 0) is number
        && request.resource.data.get('totalSpent', 0) >= 0
        && request.resource.data.get('purchaseCount', 0) is number
        && request.resource.data.get('purchaseCount', 0) >= 0;
    }

    function isValidClientUpdate(clientId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(clientAllowedFields())
        && (!changed.hasAny(['id']) || request.resource.data.get('id', clientId) == clientId)
        && (!changed.hasAny(['name']) || (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 140))
        && (!changed.hasAny(['phone']) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40))
        && (!changed.hasAny(['whatsapp']) || (request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 40))
        && (!changed.hasAny(['email']) || (request.resource.data.email is string && request.resource.data.email.size() <= 180))
        && (!changed.hasAny(['notes']) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000))
        && (!changed.hasAny(['totalSpent']) || (request.resource.data.totalSpent is number && request.resource.data.totalSpent >= 0))
        && (!changed.hasAny(['purchaseCount']) || (request.resource.data.purchaseCount is number && request.resource.data.purchaseCount >= 0));
    }
    
    // ===== FIRESTORE SECURITY RULES =====
    
    // ===== ROOT LEVEL: /users/{uid} =====
    // Users collection itself should not be directly accessible
    match /users/{uid} {
      allow read, write: if false;
      
      // SUBCOLLECTION: products
      // User can only read/write their own products
      match /products/{productId} {
        allow read: if userOwnsResource(uid);
        allow create: if userOwnsResource(uid) && isValidProductCreate(productId);
        allow update: if userOwnsResource(uid) && isValidProductUpdate(productId);
        allow delete: if userOwnsResource(uid);
      }
      
      // SUBCOLLECTION: clients
      // User can only read/write their own clients
      match /clients/{clientId} {
        allow read: if userOwnsResource(uid);
        allow create: if userOwnsResource(uid) && isValidClientCreate(clientId);
        allow update: if userOwnsResource(uid) && isValidClientUpdate(clientId);
        allow delete: if userOwnsResource(uid);
      }
      
      // SUBCOLLECTION: charges
      // User can only read their own charges
      // Writes are backend-only (admin SDK)
      match /charges/{chargeId} {
        allow read: if userOwnsResource(uid);
        allow create, update, delete: if false;
      }
      
      // SUBCOLLECTION: installments
      // Installments are created by trusted backend flows. The owner may only
      // read them and register payment progress without changing their terms.
      match /installments/{installmentId} {
        allow read: if userOwnsResource(uid);
        allow create, delete: if false;
        allow update: if userOwnsResource(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'paidAmount'])
          && request.resource.data.status is string
          && request.resource.data.status in ['pending', 'partial', 'paid', 'overdue']
          && request.resource.data.paidAmount is number
          && resource.data.amount is number
          && request.resource.data.paidAmount >= 0
          && request.resource.data.paidAmount <= resource.data.amount;
      }

      // SUBCOLLECTION: sales
      // Users may create sales only inside their own account. Existing sales
      // remain immutable from the client; stock-safe mutations belong to the
      // transactional backend flow handled separately.
      match /sales/{saleId} {
        allow read: if userOwnsResource(uid);
        allow create: if userOwnsResource(uid)
          && request.resource.data.keys().hasAll([
            'id', 'clientId', 'products', 'subtotal', 'total',
            'paymentType', 'date'
          ])
          && request.resource.data.id == saleId
          && request.resource.data.clientId is string
          && request.resource.data.clientId.size() > 0
          && request.resource.data.products is list
          && request.resource.data.products.size() > 0
          && request.resource.data.products.size() <= 100
          && request.resource.data.subtotal is number
          && request.resource.data.subtotal >= 0
          && request.resource.data.total is number
          && request.resource.data.total >= 0
          && request.resource.data.total <= request.resource.data.subtotal
          && request.resource.data.paymentType is string
          && request.resource.data.paymentType in ['avista', 'prazo']
          && request.resource.data.date is string
          && request.resource.data.date.size() > 0;
        allow update, delete: if false;
      }
      
      // SUBCOLLECTION: mercadopago_connections
      // User can read their own MP connections
      // Writes are backend-only (OAuth flow)
      match /mercadopago_connections/{connectionId} {
        allow read: if userOwnsResource(uid);
        allow create, update, delete: if false;
      }
    }
    
    // ===== ROOT LEVEL: /user_settings/{userId} =====
    // User settings should be managed by backend API only
    // No direct client access
    match /user_settings/{userId} {
      allow read, write: if false;
    }
    
    // ===== ROOT LEVEL: /admin_users/{userId} =====
    // Admin user metadata - no direct client access
    match /admin_users/{userId} {
      allow read, write: if false;
    }
    
    // ===== ROOT LEVEL: /mercadopago_oauth_states/{nonce} =====
    // OAuth state nonces - server-side only
    // Used during OAuth callback flow (backend validation)
    match /mercadopago_oauth_states/{nonce} {
      allow read, write: if false;
    }
    
    // ===== DEFAULT: Deny all other paths =====
    // Explicit deny for any path not explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
