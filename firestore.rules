rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== HELPER FUNCTIONS =====
    
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function userOwnsResource(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/account_deletion_requests/$(userId));
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }

    function productAllowedFields() {
      return [
        'id', 'name', 'brand', 'origin', 'category', 'productType',
        'costPrice', 'salePrice', 'stock', 'barcode', 'description',
        'imageUrl', 'storagePath', 'thumbnailUrl', 'thumbnailStoragePath',
        'imageId', 'photoUrl', 'image', 'photo',
        'gender', 'lastSoldDate', 'extras', 'isFeatured', 'isOnSale',
        'discountPercent', 'discount', 'promotionalPrice', 'createdAt', 'updatedAt',
        'nameNormalized', 'brandNormalized', 'categoryNormalized',
        'barcodeNormalized', 'productTypeNormalized', 'searchTokens',
        'searchSchemaVersion', 'approvedCutout', 'planAccessState', 'planAccessSelectionSource'
      ];
    }

    // PRO-07K — cutout já aprovado (Photoroom + Pixel Preservation Gate, fora desta Rule) e persistido
    // no próprio documento do produto. Shape fechado, sem bytes/base64/mask inline, sem API key, sem
    // resposta bruta de provider. `storagePath` é travado no caminho canônico e único deste produto —
    // nunca aponta para outro usuário/produto nem sobrescreve a imagem original (uma igualdade exata de
    // string também descarta `data:`/base64 de graça, sem precisar de um `.matches()` extra).
    //
    // Deliberadamente mais enxuta que o validador espelho do client (`validateApprovedProductCutoutShape`,
    // shared/approved-product-cutout.ts, que é TypeScript puro e não tem o limite de custo de avaliação
    // das Security Rules). `hasAll` seria redundante aqui: cada chave obrigatória é acessada abaixo e a
    // ausência de qualquer uma faz a Rule negar. Os campos MENOS críticos (`provider`, `family`, `context`)
    // ficam fora da checagem de valor — `hasOnly` ainda impede qualquer chave desconhecida, enquanto o
    // helper TypeScript valida o conteúdo antes da escrita.
    function isValidApprovedProductCutout(cutout, uid, productId) {
      return cutout is map
        && cutout.keys().hasOnly([
          'sourceAssetId', 'cutoutAssetId', 'storagePath', 'downloadUrl', 'width', 'height', 'mimeType',
          'coordinateSpaceVersion', 'preservesOriginalPixels', 'method', 'provider', 'createdAt', 'family', 'context'
        ])
        && cutout.sourceAssetId is string && cutout.sourceAssetId.size() > 0
        && cutout.cutoutAssetId is string && cutout.cutoutAssetId.size() > 0
        && cutout.storagePath == 'users/' + uid + '/product-cutouts/' + productId + '/cutout-v1.png'
        && cutout.width is int && cutout.width > 0 && cutout.width <= 20000
        && cutout.height is int && cutout.height > 0 && cutout.height <= 20000
        && cutout.mimeType == 'image/png'
        && cutout.coordinateSpaceVersion == 'product-image-coordinate-space-v1'
        && cutout.preservesOriginalPixels == true
        && cutout.method in ['local-heuristic', 'specialized-api', 'multimodal-model']
        && cutout.createdAt is string && cutout.createdAt.size() > 0
        && (!cutout.keys().hasAny(['downloadUrl'])
          || (cutout.downloadUrl is string && cutout.downloadUrl.size() <= 2048 && !cutout.downloadUrl.matches('(?i)^data:.*')));
    }

    // PERFORMANCE-OPTIMIZATION-03B — Firestore Rules limita CADA função a no máximo 10 `let` por corpo
    // (erro real de compilação, medido ao vivo: "Maximum allowed variable count of 10"). Isso força a
    // validação do produto a ser dividida em funções auxiliares menores em vez de uma função só — cada
    // campo ainda é lido do documento UMA VEZ (via `let`, não `request.resource.data.get(...)` repetido
    // 2-3x por campo como no contrato anterior), o que É a mesma comparação de sempre, só sem reavaliar
    // o mesmo `.get()` várias vezes. Isso abriu orçamento real dentro do limite de 1000 expressões (também
    // medido ao vivo) para validar thumbnailUrl/thumbnailStoragePath de verdade, em vez de deixá-los sem
    // checagem de tipo/tamanho/origem como na rodada anterior. Nenhuma garantia pré-existente mudou.
    function isValidProductCoreFields(data) {
      let name = data.name;
      let salePrice = data.salePrice;
      let costPrice = data.get('costPrice', 0);
      let stock = data.get('stock', 0);
      let brand = data.get('brand', '');
      let origin = data.get('origin', '');
      let category = data.get('category', '');
      let productType = data.get('productType', '');
      let barcode = data.get('barcode', '');
      let description = data.get('description', '');
      return name is string && name.size() > 0 && name.size() <= 180
        && salePrice is number && salePrice > 0 && salePrice <= 1000000
        && costPrice is number && costPrice >= 0 && costPrice <= 1000000
        && stock is number && stock >= 0 && stock <= 1000000
        && brand is string && brand.size() <= 100
        && origin is string && origin.size() <= 80
        && category is string && category.size() <= 100
        && productType is string && productType.size() <= 80
        && barcode is string && barcode.size() <= 80
        && description is string && description.size() <= 2000;
    }

    // Diferente de imageUrl/storagePath/photoUrl/image/photo (que aceitam qualquer string dentro do
    // limite de tamanho — contrato mais antigo, mais frouxo, que não é desta rodada mexer):
    // thumbnailUrl/thumbnailStoragePath são campos NOVOS e entram já com o contrato mais forte que dá
    // para pagar no orçamento — path obrigatoriamente dentro do namespace do PRÓPRIO uid+productId
    // (thumbnailStoragePath nunca aponta pra outro tenant nem para outro produto — extensão travada em
    // .webp/.jpg, as únicas que compressImage() realmente produz) e thumbnailUrl trava bucket EXATO +
    // uid EXATO + productId EXATO + objeto EXATO (nunca outro bucket, nunca um asset de outro
    // uid/produto/arquivo do MESMO bucket, nunca vira carregador de URL externa arbitrária no catálogo
    // público) — formato idêntico ao que buildPublicDownloadUrl() (server/uploads.ts) de fato produz:
    // https://firebasestorage.googleapis.com/v0/b/{bucket}/o/{encodeURIComponent(storagePath)}?alt=media
    //
    // PERFORMANCE-OPTIMIZATION-03C — dois buckets são aceitos porque são os dois ÚNICOS confirmados por
    // leitura de configuração real deste projeto (não um chute): `revenda-smart.firebasestorage.app` é
    // VITE_FIREBASE_STORAGE_BUCKET em .env/.env.local (o bucket real do client/produção); e
    // `demo-revendasmart.appspot.com` é o bucket do Firebase Emulator Suite local, usado consistentemente
    // por `script/firebase-emulator-tests.ts` (`${PROJECT_ID}.appspot.com`, PROJECT_ID="demo-revendasmart")
    // e por todos os `script/dev-*-qa.ts` desta base — travar só no bucket de produção quebraria todo o
    // fluxo de QA/teste local que este projeto já usa. `FIREBASE_STORAGE_BUCKET` (server, sem prefixo
    // VITE_) não está em NENHUM arquivo de config deste repositório — é um secret operacional (Cloud
    // Run/Secret Manager) fora do meu alcance de leitura. Se esse secret de produção divergir do bucket
    // client confirmado acima, uploads de thumbnail reais passariam a ser recusados por esta Rule
    // (thumbnail vira ausente, imageUrl principal não é afetado) — confirmar o valor real do secret
    // ANTES de publicar esta regra é responsabilidade de quem autorizar o deploy, não algo que eu possa
    // verificar sem acesso a produção.
    function isValidProductImageFields(data, uid, productId) {
      let imageUrl = data.get('imageUrl', '');
      let storagePath = data.get('storagePath', '');
      let thumbnailUrl = data.get('thumbnailUrl', '');
      let thumbnailStoragePath = data.get('thumbnailStoragePath', '');
      let imageId = data.get('imageId', '');
      let photoUrl = data.get('photoUrl', '');
      let image = data.get('image', '');
      let photo = data.get('photo', '');
      let isCanonicalJpgThumbPath = thumbnailStoragePath == 'users/' + uid + '/product-thumbnails/' + productId + '/thumb-v1.jpg';
      let isCanonicalWebpThumbPath = thumbnailStoragePath == 'users/' + uid + '/product-thumbnails/' + productId + '/thumb-v1.webp';
      return imageUrl is string && imageUrl.size() <= 2000
        && storagePath is string && storagePath.size() <= 1000
        && thumbnailUrl is string && thumbnailUrl.size() <= 2000
        && thumbnailStoragePath is string && thumbnailStoragePath.size() <= 500
        && (thumbnailStoragePath == '' || isCanonicalJpgThumbPath || isCanonicalWebpThumbPath)
        // Coerência: thumbnailUrl e thumbnailStoragePath são sempre gravados JUNTOS ou NUNCA (ver
        // add-product.tsx) — um sem o outro é um estado que a app nunca produz legitimamente.
        && (thumbnailUrl == '') == (thumbnailStoragePath == '')
        && (thumbnailUrl == '' || thumbnailUrl.matches(
              '^https://firebasestorage\\.googleapis\\.com/v0/b/(revenda-smart\\.firebasestorage\\.app|demo-revendasmart\\.appspot\\.com)/o/users%2F'
              + uid + '%2Fproduct-thumbnails%2F' + productId
              + (isCanonicalJpgThumbPath ? '%2Fthumb-v1\\.jpg\\?alt=media$' : '%2Fthumb-v1\\.webp\\?alt=media$')
            ))
        && imageId is string && imageId.size() <= 200
        && photoUrl is string && photoUrl.size() <= 2000
        && image is string && image.size() <= 2000
        && photo is string && photo.size() <= 2000;
    }

    // PLAN-IMPL-02B1 §29 — planAccessState só entra no shape aqui (validação de VALOR, "active" ou
    // "preserved" quando presente); quem impede o CLIENT de mudar seu valor é isValidProductUpdate
    // abaixo (changed.hasOnly / !changed.hasAny), nunca esta função — Admin SDK ignora Rules, então
    // reconcilePlanAccess (server) continua livre para escrever este campo.
    function isValidProductMetaFields(data) {
      let gender = data.get('gender', '');
      let lastSoldDate = data.get('lastSoldDate', '');
      let extras = data.get('extras', {});
      let isFeatured = data.get('isFeatured', false);
      let isOnSale = data.get('isOnSale', false);
      let discountPercent = data.get('discountPercent', 0);
      let discount = data.get('discount', 0);
      let promotionalPrice = data.get('promotionalPrice', 0);
      return gender is string && gender.size() <= 40
        && lastSoldDate is string && lastSoldDate.size() <= 80
        && extras is map
        && isFeatured is bool
        && isOnSale is bool
        && discountPercent is number && discountPercent >= 0 && discountPercent <= 100
        && discount is number && discount >= 0
        && promotionalPrice is number && promotionalPrice >= 0
        && data.get('planAccessState', 'active') in ['active', 'preserved']
        // PLAN-IMPL-02B2 §30 — mesmo padrão de planAccessState: validação de VALOR aqui, bloqueio de
        // mudança pelo client em isValidProductUpdate abaixo.
        && data.get('planAccessSelectionSource', 'automatic') in ['automatic', 'user'];
    }

    function isValidProductSearchFields(data) {
      let nameNormalized = data.get('nameNormalized', '');
      let brandNormalized = data.get('brandNormalized', '');
      let categoryNormalized = data.get('categoryNormalized', '');
      let barcodeNormalized = data.get('barcodeNormalized', '');
      let productTypeNormalized = data.get('productTypeNormalized', '');
      let searchTokens = data.get('searchTokens', []);
      let searchSchemaVersion = data.get('searchSchemaVersion', 0);
      return nameNormalized is string && nameNormalized.size() <= 180
        && brandNormalized is string && brandNormalized.size() <= 120
        && categoryNormalized is string && categoryNormalized.size() <= 120
        && barcodeNormalized is string && barcodeNormalized.size() <= 100
        && productTypeNormalized is string && productTypeNormalized.size() <= 100
        && searchTokens is list && searchTokens.size() <= 16
        && searchSchemaVersion is number && searchSchemaVersion >= 0 && searchSchemaVersion <= 10;
    }

    function isValidProductCreate(uid, productId) {
      let data = request.resource.data;
      let keys = data.keys();
      // Valide o shape aninhado antes da allowlist ampla do produto: dois `hasOnly` consecutivos são o
      // principal custo de avaliação, e um cutout inválido deve falhar sem pagar o segundo.
      return (!keys.hasAny(['approvedCutout'])
          || isValidApprovedProductCutout(data.approvedCutout, uid, productId))
        && keys.hasOnly(productAllowedFields())
        && keys.hasAll(['name', 'salePrice'])
        && data.get('id', productId) == productId
        && isValidProductCoreFields(data)
        && isValidProductImageFields(data, uid, productId)
        && isValidProductMetaFields(data)
        && isValidProductSearchFields(data);
    }

    function isValidProductUpdate(uid, productId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let keys = request.resource.data.keys();
      // Trocar qualquer referência da foto original invalida o cutout derivado. Fail-closed: a troca
      // deve remover approvedCutout; um novo cutout pode ser anexado depois, já derivado do novo asset.
      return (!changed.hasAny(['imageUrl', 'storagePath', 'thumbnailUrl', 'thumbnailStoragePath', 'imageId', 'photoUrl', 'image', 'photo'])
          || !keys.hasAny(['approvedCutout']))
        // PLAN-IMPL-02B1 §29 — planAccessState é gravado SÓ pelo servidor (reconcilePlanAccess, Admin
        // SDK, ignora Rules): o client nunca pode alterá-lo, mesmo mantendo o resto do documento válido.
        // Isso bloqueia tanto reativar um produto preservado quanto forjar um "preserved" para outro fim.
        // PLAN-IMPL-02B2 §30 — mesma trava para planAccessSelectionSource (só setActiveProductSelection,
        // server, grava este campo).
        && !changed.hasAny(['planAccessState', 'planAccessSelectionSource'])
        // O estado final de um update obedece exatamente ao mesmo contrato do create. Isso preserva
        // todos os limites anteriores sem repetir dezenas de `changed.hasAny(...)` caros.
        && isValidProductCreate(uid, productId);
    }

    function clientAllowedFields() {
      return [
        'id', 'name', 'phone', 'whatsapp', 'email', 'notes',
        'createdAt', 'updatedAt', 'lastPurchaseAt', 'totalSpent', 'purchaseCount'
      ];
    }

    function isNonNegativeInteger(value) {
      return value is int && value >= 0;
    }

    function serviceAllowedFields() {
      return [
        'id', 'tenantUid', 'name', 'description', 'imageUrl',
        'active', 'published', 'pricing', 'durationMinutes',
        'cost', 'bookingMode', 'createdAt', 'updatedAt', 'archivedAt', 'planAccessState', 'planAccessSelectionSource'
      ];
    }

    function serviceWorkAllowedFields() {
      return [
        'id', 'tenantUid', 'status', 'origin', 'customerId', 'customerContactSnapshot',
        'sourceQuoteId', 'sourceQuoteVersionId', 'quoteId',
        'items', 'totals', 'financialSummary', 'cost', 'createdAt', 'updatedAt',
        'startedAt', 'completedAt', 'cancelledAt'
      ];
    }

    function quoteAllowedFields() {
      return [
        'id', 'tenantUid', 'status', 'customerId',
        'draftItems', 'draftTotals', 'draftCustomerMessage', 'draftValidUntil',
        'currentVersionId', 'currentVersionNumber',
        'acceptedVersionId', 'convertedWorkId',
        'createdAt', 'updatedAt', 'lastSentAt', 'acceptedAt', 'rejectedAt', 'cancelledAt'
      ];
    }

    function isValidQuoteShape(uid, quoteId, data) {
      return data.keys().hasOnly(quoteAllowedFields())
        && data.keys().hasAll(['id', 'tenantUid', 'status', 'draftItems', 'draftTotals', 'createdAt', 'updatedAt'])
        && data.id == quoteId
        && data.tenantUid == uid
        && data.status in ['draft', 'sent', 'accepted', 'rejected', 'cancelled']
        && data.get('customerId', '') is string
        && data.draftItems is list
        && data.draftItems.size() <= 100
        && isValidServiceTotals(data.draftTotals)
        && data.get('draftCustomerMessage', '') is string
        && data.get('draftCustomerMessage', '').size() <= 4000
        && data.get('draftValidUntil', '') is string
        && data.get('draftValidUntil', '').size() <= 40
        && data.get('currentVersionId', '') is string
        && data.get('currentVersionId', '').size() <= 120
        && (!data.keys().hasAny(['currentVersionNumber'])
          || (data.currentVersionNumber is int && data.currentVersionNumber >= 1 && data.currentVersionNumber <= 100000))
        && data.get('acceptedVersionId', '') is string
        && data.get('acceptedVersionId', '').size() <= 120
        && data.get('convertedWorkId', '') is string
        && data.get('convertedWorkId', '').size() <= 120
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 40
        && data.get('lastSentAt', '') is string
        && data.get('lastSentAt', '').size() <= 40
        && data.get('acceptedAt', '') is string
        && data.get('acceptedAt', '').size() <= 40
        && data.get('rejectedAt', '') is string
        && data.get('rejectedAt', '').size() <= 40
        && data.get('cancelledAt', '') is string
        && data.get('cancelledAt', '').size() <= 40;
    }

    function isValidQuoteCreate(uid, quoteId) {
      let data = request.resource.data;
      return isValidQuoteShape(uid, quoteId, data)
        && data.status == 'draft'
        && !data.keys().hasAny([
          'currentVersionId', 'currentVersionNumber', 'acceptedVersionId', 'convertedWorkId',
          'lastSentAt', 'acceptedAt', 'rejectedAt', 'cancelledAt'
        ])
        && data.createdAt == data.updatedAt;
    }

    function isValidQuoteUpdate(uid, quoteId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.tenantUid == uid
        && resource.data.status == 'draft'
        && request.resource.data.status == 'draft'
        && request.resource.data.id == resource.data.id
        && request.resource.data.tenantUid == resource.data.tenantUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.get('currentVersionId', '') == resource.data.get('currentVersionId', '')
        && request.resource.data.get('currentVersionNumber', null) == resource.data.get('currentVersionNumber', null)
        && request.resource.data.get('acceptedVersionId', '') == resource.data.get('acceptedVersionId', '')
        && request.resource.data.get('convertedWorkId', '') == resource.data.get('convertedWorkId', '')
        && request.resource.data.get('lastSentAt', '') == resource.data.get('lastSentAt', '')
        && request.resource.data.get('acceptedAt', '') == resource.data.get('acceptedAt', '')
        && request.resource.data.get('rejectedAt', '') == resource.data.get('rejectedAt', '')
        && request.resource.data.get('cancelledAt', '') == resource.data.get('cancelledAt', '')
        && changed.hasOnly(['customerId', 'draftItems', 'draftTotals', 'draftCustomerMessage', 'draftValidUntil', 'updatedAt'])
        && changed.hasAny(['updatedAt'])
        && request.resource.data.updatedAt != resource.data.updatedAt
        && isValidQuoteShape(uid, quoteId, request.resource.data);
    }

    function quoteVersionAllowedFields() {
      return [
        'id', 'tenantUid', 'quoteId', 'versionNumber', 'customerId',
        'items', 'totals', 'customerMessage', 'validUntil', 'createdAt', 'sentAt'
      ];
    }

    function isValidQuoteVersionShape(uid, quoteId, versionId, data) {
      return data.keys().hasOnly(quoteVersionAllowedFields())
        && data.keys().hasAll(['id', 'tenantUid', 'quoteId', 'versionNumber', 'items', 'totals', 'createdAt', 'sentAt'])
        && data.id == versionId
        && data.tenantUid == uid
        && data.quoteId == quoteId
        && data.versionNumber is int
        && data.versionNumber >= 1
        && data.versionNumber <= 100000
        && data.get('customerId', '') is string
        && data.items is list
        && data.items.size() <= 100
        && isValidServiceTotals(data.totals)
        && data.get('customerMessage', '') is string
        && data.get('customerMessage', '').size() <= 4000
        && data.get('validUntil', '') is string
        && data.get('validUntil', '').size() <= 40
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.createdAt.size() <= 40
        && data.sentAt is string
        && data.sentAt.size() > 0
        && data.sentAt.size() <= 40;
    }

    function isValidServicePricing(pricing) {
      return pricing is map
        && (
          (pricing.keys().hasOnly(['mode', 'priceCents'])
            && pricing.mode == 'fixed'
            && isNonNegativeInteger(pricing.priceCents))
          || (pricing.keys().hasOnly(['mode', 'startingAtPriceCents'])
            && pricing.mode == 'starting_at'
            && isNonNegativeInteger(pricing.startingAtPriceCents))
          || (pricing.keys().hasOnly(['mode'])
            && pricing.mode == 'quote')
        );
    }

    function isValidOptionalCost(cost) {
      return cost is map
        && (
          (cost.keys().hasOnly(['kind'])
            && cost.kind == 'unknown')
          || (cost.keys().hasOnly(['kind', 'amountCents'])
            && cost.kind == 'known'
            && isNonNegativeInteger(cost.amountCents))
        );
    }

    function isValidServiceTotals(totals) {
      return totals is map
        && totals.keys().hasOnly([
          'serviceRevenueCents', 'productRevenueCents', 'additionalRevenueCents',
          'discountTotalCents', 'contractedTotalCents'
        ])
        && totals.keys().hasAll([
          'serviceRevenueCents', 'productRevenueCents', 'additionalRevenueCents',
          'discountTotalCents', 'contractedTotalCents'
        ])
        && isNonNegativeInteger(totals.serviceRevenueCents)
        && isNonNegativeInteger(totals.productRevenueCents)
        && isNonNegativeInteger(totals.additionalRevenueCents)
        && isNonNegativeInteger(totals.discountTotalCents)
        && isNonNegativeInteger(totals.contractedTotalCents);
    }

    function isValidServiceWorkFinancialSummary(summary) {
      return summary is map
        && summary.keys().hasOnly([
          'grossReceivedCents', 'refundedTotalCents', 'netReceivedCents'
        ])
        && summary.keys().hasAll([
          'grossReceivedCents', 'refundedTotalCents', 'netReceivedCents'
        ])
        && isNonNegativeInteger(summary.grossReceivedCents)
        && isNonNegativeInteger(summary.refundedTotalCents)
        && isNonNegativeInteger(summary.netReceivedCents)
        && summary.refundedTotalCents <= summary.grossReceivedCents
        && summary.netReceivedCents == summary.grossReceivedCents - summary.refundedTotalCents;
    }

    function isZeroServiceWorkFinancialSummary(summary) {
      return isValidServiceWorkFinancialSummary(summary)
        && summary.grossReceivedCents == 0
        && summary.refundedTotalCents == 0
        && summary.netReceivedCents == 0;
    }

    function currentServiceWorkNetReceivedCents() {
      return resource.data.get('financialSummary', null) is map
        ? resource.data.financialSummary.netReceivedCents
        : 0;
    }

    function isValidServiceShape(uid, serviceId, data) {
      return data.keys().hasOnly(serviceAllowedFields())
        && data.keys().hasAll([
          'id', 'tenantUid', 'name', 'active', 'published',
          'pricing', 'cost', 'bookingMode', 'createdAt', 'updatedAt'
        ])
        && data.id == serviceId
        && data.tenantUid == uid
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 180
        && data.get('description', '') is string
        && data.get('description', '').size() <= 2000
        && data.get('imageUrl', '') is string
        && data.get('imageUrl', '').size() <= 2000
        && data.active is bool
        && data.published is bool
        && isValidServicePricing(data.pricing)
        && (!data.keys().hasAny(['durationMinutes'])
          || (data.durationMinutes is int && data.durationMinutes > 0))
        && isValidOptionalCost(data.cost)
        && data.bookingMode in ['none', 'instant', 'request']
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 40
        && data.get('archivedAt', '') is string
        && data.get('archivedAt', '').size() <= 40
        // PLAN-IMPL-02B1 §29 — validação de VALOR ("active"/"preserved" quando presente); quem impede o
        // CLIENT de mudar seu valor é isValidServiceUpdate abaixo, nunca esta função — mesmo padrão de
        // isValidProductMetaFields/isValidProductUpdate (Admin SDK ignora Rules e continua livre para
        // escrever este campo via reconcilePlanAccess).
        && data.get('planAccessState', 'active') in ['active', 'preserved']
        // PLAN-IMPL-02B2 §30 — mesmo padrão de planAccessState: validação de VALOR aqui, bloqueio de
        // mudança pelo client em isValidServiceUpdate abaixo.
        && data.get('planAccessSelectionSource', 'automatic') in ['automatic', 'user'];
    }

    function isValidServiceCreate(uid, serviceId) {
      return isValidServiceShape(uid, serviceId, request.resource.data);
    }

    function isValidServiceUpdate(uid, serviceId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.tenantUid == uid
        && request.resource.data.tenantUid == resource.data.tenantUid
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        // PLAN-IMPL-02B1 §29 — mesma trava de isValidProductUpdate: planAccessState é gravado só pelo
        // servidor, o client nunca pode alterá-lo diretamente. PLAN-IMPL-02B2 §30 — mesma trava para
        // planAccessSelectionSource (só setActiveServiceSelection, server, grava este campo).
        && !changed.hasAny(['planAccessState', 'planAccessSelectionSource'])
        && isValidServiceShape(uid, serviceId, request.resource.data);
    }

    function isValidBookingContactSnapshot(data) {
      return data is map && data.keys().hasOnly(['name', 'phone'])
        && data.keys().hasAll(['name', 'phone'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 140
        && data.phone is string && data.phone.size() > 0 && data.phone.size() <= 40;
    }

    function isValidServiceWorkShape(uid, workId, data) {
      return data.keys().hasOnly(serviceWorkAllowedFields())
        && data.keys().hasAll([
          'id', 'tenantUid', 'status', 'origin', 'items', 'totals', 'cost', 'createdAt', 'updatedAt'
        ])
        && data.id == workId
        && data.tenantUid == uid
        && data.status in ['planned', 'in_progress', 'completed', 'cancelled']
        && data.origin in ['manual', 'booking', 'quote', 'request']
        && (!data.keys().hasAny(['customerContactSnapshot']) || isValidBookingContactSnapshot(data.customerContactSnapshot))
        && data.get('customerId', '') is string
        && data.get('sourceQuoteId', '') is string
        && data.get('sourceQuoteId', '').size() <= 120
        && data.get('quoteId', '') is string
        && data.get('quoteId', '').size() <= 120
        && data.get('sourceQuoteVersionId', '') is string
        && data.get('sourceQuoteVersionId', '').size() <= 120
        && data.items is list
        && data.items.size() <= 100
        && isValidServiceTotals(data.totals)
        && isValidOptionalCost(data.cost)
        && data.createdAt is string
        && data.createdAt.size() > 0
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() > 0
        && data.updatedAt.size() <= 40
        && data.get('startedAt', '') is string
        && data.get('startedAt', '').size() <= 40
        && data.get('completedAt', '') is string
        && data.get('completedAt', '').size() <= 40
        && data.get('cancelledAt', '') is string
        && data.get('cancelledAt', '').size() <= 40
        && (!data.keys().hasAny(['financialSummary'])
          || isValidServiceWorkFinancialSummary(data.financialSummary))
        && ((data.origin == 'quote'
            && data.get('sourceQuoteId', '') != ''
            && data.get('sourceQuoteVersionId', '') != '')
          || (data.origin != 'quote'
            && data.get('sourceQuoteId', '') == ''
            && data.get('sourceQuoteVersionId', '') == ''));
    }

    function isValidServiceWorkCreate(uid, workId) {
      let data = request.resource.data;
      return isValidServiceWorkShape(uid, workId, data)
        && data.origin == 'manual'
        && !data.keys().hasAny(['customerContactSnapshot'])
        && data.status == 'planned'
        && data.keys().hasAll(['financialSummary'])
        && isZeroServiceWorkFinancialSummary(data.financialSummary)
        && !data.keys().hasAny(['sourceQuoteId', 'sourceQuoteVersionId', 'quoteId'])
        && !data.keys().hasAny(['startedAt', 'completedAt', 'cancelledAt'])
        && data.createdAt == data.updatedAt;
    }

    function isValidServiceWorkUpdate(uid, workId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.tenantUid == uid
        && request.resource.data.tenantUid == resource.data.tenantUid
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.origin == resource.data.origin
        && request.resource.data.status == resource.data.status
        && request.resource.data.get('startedAt', null) == resource.data.get('startedAt', null)
        && request.resource.data.get('completedAt', null) == resource.data.get('completedAt', null)
        && request.resource.data.get('cancelledAt', null) == resource.data.get('cancelledAt', null)
        && request.resource.data.get('sourceQuoteId', '') == resource.data.get('sourceQuoteId', '')
        && request.resource.data.get('sourceQuoteVersionId', '') == resource.data.get('sourceQuoteVersionId', '')
        && request.resource.data.get('quoteId', '') == resource.data.get('quoteId', '')
        && request.resource.data.get('financialSummary', null) == resource.data.get('financialSummary', null)
        && changed.hasOnly(['items', 'totals', 'cost', 'updatedAt'])
        && changed.hasAny(['updatedAt'])
        && request.resource.data.updatedAt != resource.data.updatedAt
        && request.resource.data.totals.contractedTotalCents >= currentServiceWorkNetReceivedCents()
        && isValidServiceWorkShape(uid, workId, request.resource.data);
    }

    function isValidClientCreate(clientId) {
      return request.resource.data.keys().hasOnly(clientAllowedFields())
        && request.resource.data.keys().hasAll(['name'])
        && request.resource.data.get('id', clientId) == clientId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 140
        && request.resource.data.get('phone', '') is string
        && request.resource.data.get('phone', '').size() <= 40
        && request.resource.data.get('whatsapp', '') is string
        && request.resource.data.get('whatsapp', '').size() <= 40
        && request.resource.data.get('email', '') is string
        && request.resource.data.get('email', '').size() <= 180
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 2000
        && request.resource.data.get('totalSpent', 0) is number
        && request.resource.data.get('totalSpent', 0) >= 0
        && request.resource.data.get('purchaseCount', 0) is number
        && request.resource.data.get('purchaseCount', 0) >= 0
        // PLAN-IMPL-07A — lastPurchaseAt já estava no allowlist (clientAllowedFields) sem nenhuma
        // validação de tipo/tamanho, igual totalSpent/purchaseCount ao lado; fechado agora que o campo
        // passa a ser escrito de verdade (server-side, dentro da mesma transação de finalizeSaleTransaction
        // que já escreve Product.lastSoldDate) — mesmo formato/limite de tamanho já usado lá.
        && request.resource.data.get('lastPurchaseAt', '') is string
        && request.resource.data.get('lastPurchaseAt', '').size() <= 80;
    }

    function isValidClientUpdate(clientId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(clientAllowedFields())
        && (!changed.hasAny(['id']) || request.resource.data.get('id', clientId) == clientId)
        && (!changed.hasAny(['name']) || (request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 140))
        && (!changed.hasAny(['phone']) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40))
        && (!changed.hasAny(['whatsapp']) || (request.resource.data.whatsapp is string && request.resource.data.whatsapp.size() <= 40))
        && (!changed.hasAny(['email']) || (request.resource.data.email is string && request.resource.data.email.size() <= 180))
        && (!changed.hasAny(['notes']) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000))
        && (!changed.hasAny(['totalSpent']) || (request.resource.data.totalSpent is number && request.resource.data.totalSpent >= 0))
        && (!changed.hasAny(['purchaseCount']) || (request.resource.data.purchaseCount is number && request.resource.data.purchaseCount >= 0))
        && (!changed.hasAny(['lastPurchaseAt']) || (request.resource.data.lastPurchaseAt is string && request.resource.data.lastPurchaseAt.size() <= 80));
    }

    // Encomendas/Pedidos: rascunho de pedido do cliente, sem baixa de estoque, sem venda e sem
    // cobrança automática (essas ações continuam existindo só nos fluxos próprios de Vendas/Cobranças).
    //
    // LIMITAÇÃO CONHECIDA E INTENCIONAL — items[]:
    // Security Rules não têm iterador para percorrer uma lista de tamanho variável, então NÃO é
    // possível validar aqui name/quantity/unitPrice/productId/imageUrl de CADA item. O que a Rule
    // garante sobre items é apenas: é uma lista, não vazia, com no máximo 100 elementos. A validação
    // detalhada de cada OrderItem continua no frontend (NewOrderSheet + calculateOrderItemSubtotal).
    // Se um dia for preciso enforcement real por item, o caminho é mover items para uma subcoleção —
    // decisão de arquitetura deliberada, não feita agora.
    //
    // LIMITAÇÃO INTENCIONAL — total:
    // A Rule NÃO valida total == soma(quantity * unitPrice), e isso é por design: pedido é RASCUNHO e
    // order.total NÃO é autoridade financeira. Quando um pedido virar venda, o backend terá de
    // recalcular tudo do zero a partir dos produtos relidos (mesmo princípio de /api/sales/finalize,
    // que já ignora qualquer preço vindo do cliente).
    function orderAllowedFields() {
      return [
        'id', 'clientId', 'clientName', 'clientPhone', 'storeName', 'status', 'items', 'total',
        'createdAt', 'updatedAt', 'expectedDate', 'notes'
      ];
    }

    function orderRequiredFields() {
      return ['id', 'clientId', 'clientName', 'status', 'items', 'total', 'createdAt', 'updatedAt'];
    }

    function isValidOrderCreate(orderId) {
      let data = request.resource.data;
      return data.keys().hasOnly(orderAllowedFields())
        && data.keys().hasAll(orderRequiredFields())
        && data.id is string
        && data.id == orderId
        && data.id.size() >= 1
        && data.id.size() <= 64
        && data.clientId is string
        && data.clientId.size() >= 1
        && data.clientId.size() <= 128
        && data.clientName is string
        && data.clientName.size() >= 1
        && data.clientName.size() <= 140
        // O app sempre cria o pedido com status "new" — mudar de status é uma ação separada (update).
        && data.status == 'new'
        && data.items is list
        && data.items.size() >= 1
        && data.items.size() <= 100
        && data.total is number
        && data.total >= 0
        && data.total <= 100000000
        && data.createdAt is string
        && data.createdAt.size() <= 40
        && data.updatedAt is string
        && data.updatedAt.size() <= 40
        // Documento recém-criado: os dois carimbos nascem iguais (useOrdersData usa o mesmo `now`).
        // Isso impede que um update seja disfarçado de create para burlar as travas de transição.
        && data.createdAt == data.updatedAt
        && data.get('clientPhone', '') is string
        && data.get('clientPhone', '').size() <= 40
        && data.get('storeName', '') is string
        && data.get('storeName', '').size() <= 140
        && data.get('expectedDate', '') is string
        && data.get('expectedDate', '').size() <= 40
        && data.get('notes', '') is string
        && data.get('notes', '').size() <= 2000;
    }

    // Fluxo de status sempre para frente, mais cancelamento. Entregue e cancelado são terminais: nada
    // sai deles. Espelha ORDER_STATUS_TRANSITIONS em client/src/lib/orders.ts — os dois precisam
    // continuar iguais, e há teste de emulador cobrindo cada aresta permitida e proibida.
    function isValidOrderStatusTransition(oldStatus, newStatus) {
      return (oldStatus == 'new' && (newStatus == 'in_progress' || newStatus == 'cancelled'))
        || (oldStatus == 'in_progress' && (newStatus == 'ready' || newStatus == 'cancelled'))
        || (oldStatus == 'ready' && (newStatus == 'delivered' || newStatus == 'cancelled'));
    }

    // Depois de criado, o cliente só pode empurrar o status adiante. Nenhuma tela edita cliente,
    // itens, total, telefone, nome da loja, previsão ou observações — e a Rule impede isso mesmo que
    // alguém tente por fora do app. Os snapshots (clientPhone/storeName) são imutáveis por definição.
    function isValidOrderUpdate(orderId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['status', 'updatedAt'])
        // Ambos precisam MUDAR de verdade: um update que não altera status não tem por que existir, e
        // um que mexe no status sem tocar em updatedAt deixaria o carimbo mentindo sobre o documento.
        && changed.hasAll(['status', 'updatedAt'])
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40
        && request.resource.data.updatedAt != resource.data.updatedAt
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidOrderStatusTransition(resource.data.status, request.resource.data.status);
    }

    // Histórico de Anúncios (marketingHistory): registro do que o lojista gerou/compartilhou.
    // Não é dado financeiro nem operacional — é histórico de uso —, mas continua sendo dado privado
    // do lojista e precisa do mesmo isolamento por uid das demais coleções. Sem uma Rule própria,
    // esta subcoleção dependia apenas do default-deny da raiz e as escritas eram silenciosamente
    // negadas (o app cai para histórico local no catch), o que mascarava a ausência de contrato.
    //
    // A allowlist reflete o payload REAL de sanitizeMarketingHistoryPayload — campos ausentes são
    // normais, porque o sanitizador remove tudo que estiver undefined antes de gravar.
    function marketingHistoryAllowedFields() {
      return [
        'action', 'productId', 'productName', 'productBrand', 'productImageUrl', 'productVolume',
        'stockStatus', 'imageUrl', 'photoUrl', 'image', 'imageId', 'generatedText', 'template',
        'templateId', 'themeId', 'price', 'priceText', 'headline', 'note', 'ctaText', 'storeName',
        'storeLogoUrl', 'primaryColor', 'showBrand', 'showVolume', 'showStockStatus',
        'showWhatsAppCta', 'backgroundStyle', 'catalogUrl', 'createdAt', 'createdAtISO',
        'updatedAt', 'updatedAtISO', 'source', 'productAssetSnapshot',
        // ADS-PRO-03 — identidade reproduzível do Anúncios Pro. Todos OPCIONAIS: histórico clássico
        // (existente e futuro) nunca os envia e continua válido sem eles.
        'mode', 'composerVersion', 'creativeFamily', 'creativeConceptId', 'format',
        'proBackground', 'proCutout'
      ];
    }

    function isValidProBackground(background) {
      return background is map
        && background.keys().hasOnly(['sourceType', 'backgroundId', 'backgroundVersion', 'backgroundFamily', 'generationId'])
        && background.keys().hasAll(['sourceType'])
        && background.sourceType is string
        && background.sourceType in ['GENERATED_DETERMINISTIC', 'STATIC_ASSET', 'AI_GENERATED']
        && background.get('backgroundId', '') is string
        && background.get('backgroundId', '').size() <= 120
        && background.get('backgroundVersion', 1) is int
        && background.get('backgroundVersion', 1) > 0
        && background.get('backgroundFamily', '') is string
        && background.get('backgroundFamily', '').size() <= 40
        && background.get('generationId', '') is string
        && background.get('generationId', '').size() <= 120;
    }

    function isValidProCutout(cutout) {
      return cutout is map
        && cutout.keys().hasOnly(['cutoutAssetId', 'storagePath', 'sourceAssetId'])
        && cutout.keys().hasAll(['cutoutAssetId', 'storagePath'])
        && cutout.cutoutAssetId is string
        && cutout.cutoutAssetId.size() > 0
        && cutout.cutoutAssetId.size() <= 512
        && cutout.storagePath is string
        && cutout.storagePath.size() > 0
        && cutout.storagePath.size() <= 1000
        && !cutout.storagePath.matches('(?i)data:.*')
        && cutout.get('sourceAssetId', '') is string
        && cutout.get('sourceAssetId', '').size() <= 512;
    }

    function isValidProductAssetSnapshot(snapshot, historyProductId) {
      return snapshot is map
        && snapshot.keys().hasOnly(['productId', 'assetId', 'assetRef', 'sourceUrl', 'width', 'height', 'mimeType'])
        && snapshot.keys().hasAll(['productId', 'assetId', 'assetRef', 'width', 'height'])
        && snapshot.productId is string
        && snapshot.productId.size() > 0
        && snapshot.productId.size() <= 128
        && snapshot.productId == historyProductId
        && snapshot.assetId is string
        && snapshot.assetId.size() > 0
        && snapshot.assetId.size() <= 256
        && snapshot.assetRef is string
        && snapshot.assetRef.size() > 0
        && snapshot.assetRef.size() <= 512
        && !snapshot.assetRef.matches('(?i)data:.*')
        && snapshot.width is int
        && snapshot.width > 0
        && snapshot.width <= 100000
        && snapshot.height is int
        && snapshot.height > 0
        && snapshot.height <= 100000
        && snapshot.get('sourceUrl', '') is string
        && snapshot.get('sourceUrl', '').size() <= 2048
        && !snapshot.get('sourceUrl', '').matches('(?i)data:.*')
        && snapshot.get('mimeType', 'image/unknown') is string
        && snapshot.get('mimeType', 'image/unknown').size() <= 80
        && snapshot.get('mimeType', 'image/unknown').matches('image/[A-Za-z0-9.+-]+');
    }

    function isValidMarketingHistoryShape() {
      let data = request.resource.data;
      return data.keys().hasOnly(marketingHistoryAllowedFields())
        && data.action in ['generated', 'downloaded', 'copied', 'shared', 'edited', 'duplicated']
        && data.get('productId', '') is string
        && data.get('productId', '').size() <= 128
        && data.get('productName', '') is string
        && data.get('productName', '').size() <= 200
        && data.get('generatedText', '') is string
        && data.get('generatedText', '').size() <= 4000
        && data.get('note', '') is string
        && data.get('note', '').size() <= 1000
        && data.get('storeName', '') is string
        && data.get('storeName', '').size() <= 140
        && data.get('createdAtISO', '') is string
        && data.get('createdAtISO', '').size() <= 40
        && (!data.keys().hasAny(['productAssetSnapshot'])
          || isValidProductAssetSnapshot(data.productAssetSnapshot, data.get('productId', '')))
        // `source` registra de onde o anúncio nasceu. É OPCIONAL — entradas legadas, criadas antes do
        // campo existir, não o têm e continuam válidas. Mas, quando presente, só os dois valores que
        // o app realmente produz são aceitos: nada de string arbitrária entrando no histórico.
        && data.get('source', 'manual') in ['catalog', 'manual']
        // ADS-PRO-03 — todos opcionais; histórico clássico nunca os envia.
        && data.get('mode', 'classic') in ['classic', 'pro']
        && data.get('composerVersion', 1) is int
        && data.get('composerVersion', 1) > 0
        && data.get('creativeFamily', '') is string
        && data.get('creativeFamily', '').size() <= 40
        && data.get('creativeConceptId', '') is string
        && data.get('creativeConceptId', '').size() <= 80
        && data.get('format', '') is string
        && data.get('format', '') in ['', 'square', 'portrait', 'story']
        && (!data.keys().hasAny(['proBackground']) || isValidProBackground(data.proBackground))
        && (!data.keys().hasAny(['proCutout']) || isValidProCutout(data.proCutout));
    }

    function isValidMarketingHistoryCreate() {
      return isValidMarketingHistoryShape()
        && request.resource.data.keys().hasAll(['action', 'createdAtISO']);
    }

    // A edição de um anúncio salvo reescreve o conteúdo, mas a data de criação é histórica e não pode
    // ser reescrita — é o que permite auditar quando a ação original aconteceu.
    function isValidMarketingHistoryUpdate() {
      return isValidMarketingHistoryShape()
        && request.resource.data.get('createdAtISO', '') == resource.data.get('createdAtISO', '');
    }

    // ADS-PRO-03C — validação estrita do AdsProCreativeProfileV1.
    // Apenas schemaVersion (1) e preferredStyles (lista de MarketingProStyle, máx 5 itens sem tipos estranhos).
    function hasUniqueAdsProStyles(styles) {
      return styles.size() <= 1
        || (styles.size() == 2 && styles[0] != styles[1])
        || (styles.size() == 3 && styles[0] != styles[1] && styles[0] != styles[2] && styles[1] != styles[2])
        || (styles.size() == 4 && styles[0] != styles[1] && styles[0] != styles[2] && styles[0] != styles[3]
          && styles[1] != styles[2] && styles[1] != styles[3] && styles[2] != styles[3])
        || (styles.size() == 5 && styles[0] != styles[1] && styles[0] != styles[2] && styles[0] != styles[3] && styles[0] != styles[4]
          && styles[1] != styles[2] && styles[1] != styles[3] && styles[1] != styles[4]
          && styles[2] != styles[3] && styles[2] != styles[4] && styles[3] != styles[4]);
    }

    function isValidAdsProCreativeProfile(data) {
      return data is map
        && data.keys().hasOnly(['schemaVersion', 'preferredStyles'])
        && data.keys().hasAll(['schemaVersion', 'preferredStyles'])
        && data.schemaVersion == 1
        && data.preferredStyles is list
        && data.preferredStyles.size() <= 5
        && data.preferredStyles.hasOnly(['luxury', 'editorial', 'modern', 'minimal', 'sensory'])
        && hasUniqueAdsProStyles(data.preferredStyles);
    }
    // ===== FIRESTORE SECURITY RULES =====
    
    // ===== ROOT LEVEL: /users/{uid} =====
    // Users collection itself should not be directly accessible
    match /users/{uid} {
      allow read, write: if false;
      
      // SUBCOLLECTION: products
      // User can only read/write their own products
      match /products/{productId} {
        allow read: if userOwnsResource(uid);
        allow create: if false;
        allow update: if userOwnsResource(uid) && isValidProductUpdate(uid, productId);
        allow delete: if false;
      }
      
      // SUBCOLLECTION: clients
      // User can only read/write their own clients
      match /clients/{clientId} {
        allow read: if userOwnsResource(uid);
        // Client creation is server-authoritative so plan quota and ownership are
        // enforced atomically in /api/clients.
        allow create: if false;
        allow update: if userOwnsResource(uid) && isValidClientUpdate(clientId);
        allow delete: if false;
      }

      match /services/{serviceId} {
        allow read: if userOwnsResource(uid);
        allow create: if false;
        allow update: if userOwnsResource(uid) && isValidServiceUpdate(uid, serviceId);
        allow delete: if false;
      }

      match /planUsage/{usageId} {
        allow read, write: if false;
      }

      match /planMutationIdempotency/{key} {
        allow read, write: if false;
      }

      // PLAN-IMPL-02B1 §24 — status de reconciliação de downgrade (pending/running/completed/failed),
      // escrito só pelo caminho em chunks de reconcilePlanAccess (server/plan-access-reconciliation.ts)
      // para tenants grandes demais para uma única transação. Mesmo padrão server-only de planUsage.
      match /planAccessReconciliation/{docId} {
        allow read, write: if false;
      }

      // PLAN-IMPL-05 — lock de preparação profissional do Ads Pro (server/ads-pro-preparation-quota.ts),
      // protege concorrência do mesmo produto/mês. Mesmo padrão server-only de planUsage/planAccessReconciliation.
      match /adsProPreparationLocks/{productId} {
        allow read, write: if false;
      }

      match /serviceWorks/{workId} {
        allow read: if userOwnsResource(uid);
        allow create: if userOwnsResource(uid) && isValidServiceWorkCreate(uid, workId);
        allow update: if userOwnsResource(uid) && isValidServiceWorkUpdate(uid, workId);
        allow delete: if false;

        match /payments/{paymentId} {
          allow read: if userOwnsResource(uid);
          allow create, update, delete: if false;

          match /refunds/{refundId} {
            allow read: if userOwnsResource(uid);
            allow create, update, delete: if false;
          }
        }
      }

      match /quotes/{quoteId} {
        allow read: if userOwnsResource(uid);
        allow create: if userOwnsResource(uid) && isValidQuoteCreate(uid, quoteId);
        allow update: if userOwnsResource(uid) && isValidQuoteUpdate(uid, quoteId);
        allow delete: if false;

        match /versions/{versionId} {
          allow read: if userOwnsResource(uid) && isValidQuoteVersionShape(uid, quoteId, versionId, resource.data);
          allow create, update, delete: if false;
        }
      }

      match /quoteCommandIdempotency/{key} {
        allow read, write: if false;
      }

      match /servicePaymentCommandIdempotency/{key} {
        allow read, write: if false;
      }

      // SERV-BOOK-01 — autoridade de concorrência é sempre o servidor (Admin SDK ignora Rules). O client
      // só pode LER o próprio Hold/Booking já confirmado pelo servidor — nunca criar/alterar/apagar, e
      // nunca ver o estado interno de ScheduleLock (que decide ownership/expiração de cada segmento de 5
      // minutos) nem a coleção de idempotência.
      match /bookingHolds/{holdId} {
        allow read: if userOwnsResource(uid);
        allow create, update, delete: if false;
      }

      match /bookings/{bookingId} {
        allow read: if userOwnsResource(uid);
        allow create, update, delete: if false;
      }

      match /scheduleLocks/{lockId} {
        allow read, write: if false;
      }

      match /serviceBookingCommandIdempotency/{key} {
        allow read, write: if false;
      }

      // SERV-AVAIL-01 — expediente (ServiceResourceSchedule) e bloqueios extraordinários
      // (ServiceAvailabilityBlock) são dados administrativos legíveis pelo próprio dono, mas escritos
      // SEMPRE pelo servidor (server/service-availability-commands.ts) — mesmo padrão de bookingHolds/
      // bookings acima. A coleção de idempotência do domínio de disponibilidade fica invisível ao client,
      // mesmo padrão de serviceBookingCommandIdempotency.
      match /serviceResourceSchedules/{resourceId} {
        allow read: if userOwnsResource(uid);
        allow create, update, delete: if false;
      }

      match /serviceAvailabilityBlocks/{blockId} {
        allow read: if userOwnsResource(uid);
        allow create, update, delete: if false;
      }

      match /serviceAvailabilityCommandIdempotency/{key} {
        allow read, write: if false;
      }

      // SUBCOLLECTION: orders (Encomendas/Pedidos)
      // User can only read/create their own orders. Update is limited to status changes — no other
      // field can be edited from the client. Deletion is disabled: there is no delete UI today.
      // SUBCOLLECTION: marketingHistory (Histórico de Anúncios)
      // Isolado por uid como o resto. Delete é permitido porque a UI realmente apaga registros
      // (remover item e "limpar histórico"), diferente de orders, onde apagar não existe.
      match /marketingHistory/{entryId} {
        allow read: if userOwnsResource(uid);
        allow create: if userOwnsResource(uid) && isValidMarketingHistoryCreate();
        allow update: if userOwnsResource(uid) && isValidMarketingHistoryUpdate();
        allow delete: if userOwnsResource(uid);
      }

      // SUBCOLLECTION: adsPro
      // ADS-PRO-03C — Perfil Criativo V1 do Anúncios Pro (AdsProCreativeProfileV1).
      // Preferências visuais do lojista, tenant-scoped por construção em users/{uid}.
      // Documento canônico restrito a 'creativeProfile'. Delete permitido para redefinir perfil (clear).
      match /adsPro/{docId} {
        allow read: if userOwnsResource(uid);
        allow create, update: if userOwnsResource(uid)
          && docId == 'creativeProfile'
          && isValidAdsProCreativeProfile(request.resource.data);
        allow delete: if userOwnsResource(uid) && docId == 'creativeProfile';
      }

      match /orders/{orderId} {
        allow read: if userOwnsResource(uid);
        allow create: if userOwnsResource(uid) && isValidOrderCreate(orderId);
        allow update: if userOwnsResource(uid) && isValidOrderUpdate(orderId);
        allow delete: if false;
      }
      
      // SUBCOLLECTION: charges
      // User can only read their own charges
      // Writes are backend-only (admin SDK)
      match /charges/{chargeId} {
        allow read: if userOwnsResource(uid);
        allow create, update, delete: if false;
      }
      
      // SUBCOLLECTION: installments
      // Installments are created by trusted backend flows. The owner may only
      // read them and register payment progress without changing their terms.
      match /installments/{installmentId} {
        allow read: if userOwnsResource(uid);
        allow create, delete: if false;
        allow update: if userOwnsResource(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'paidAmount'])
          && request.resource.data.status is string
          && request.resource.data.status in ['pending', 'partial', 'paid', 'overdue']
          && request.resource.data.paidAmount is number
          && resource.data.amount is number
          && request.resource.data.paidAmount >= 0
          && request.resource.data.paidAmount <= resource.data.amount;
      }

      // SUBCOLLECTION: sales
      // LGPD/segurança (REVENDASMART-LGPD-ANPD-REMEDIATION-01, Fase 9): a criação de venda só acontece
      // pelo backend (POST /api/sales/finalize, Admin SDK — que ignora estas regras), dentro de uma
      // transaction que recalcula preço/total a partir dos produtos e decrementa estoque de forma
      // segura. Nenhum caller no cliente grava diretamente nesta coleção (confirmado por auditoria de
      // código — a fila offline em `offline-sales-queue.ts` escreve em `pendingSales`, nunca aqui). A
      // regra de `create` client-side foi removida: ela só validava formato, nunca recalculava total
      // nem decrementava estoque, permitindo ao próprio dono da conta gravar receita fabricada dentro
      // do seu próprio tenant. Existing sales continuam imutáveis do cliente.
      match /sales/{saleId} {
        allow read: if userOwnsResource(uid);
        allow create, update, delete: if false;
      }

      // SUBCOLLECTION: pendingSales
      // RELEASE-QUALITY-04 §3 — fila local de vendas à vista feitas offline. O cliente escreve e
      // sincroniza esses documentos sozinho antes de virarem uma venda real (via
      // POST /api/sales/finalize, Admin SDK); são transitórios e nunca a fonte de verdade do
      // faturamento, que continua sendo só `sales`. `payload` é imutável após a criação — só `status`
      // (e o texto de erro de uma falha) pode mudar, o que impede o cliente de reescrever a venda em
      // trânsito para outra coisa.
      // RELEASE-QUALITY-05 §9: "conflict" (recusa de negócio explicável — estoque/produto mudou, nunca
      // decrementa nada) foi adicionado ao lado de "failed" (falha genérica). `conflictReason`, quando
      // presente, precisa ser um dos motivos que o servidor já sabe distinguir por código de erro.
      match /pendingSales/{saleId} {
        allow read: if userOwnsResource(uid);
        allow create: if userOwnsResource(uid)
          && request.resource.data.id == saleId
          && request.resource.data.status == 'pending'
          && request.resource.data.payload is map
          && request.resource.data.payload.saleId == saleId
          && request.resource.data.payload.paymentType == 'avista';
        allow update: if userOwnsResource(uid)
          && request.resource.data.id == resource.data.id
          && request.resource.data.payload == resource.data.payload
          && request.resource.data.status is string
          && request.resource.data.status in ['pending', 'syncing', 'failed', 'conflict']
          && (!('conflictReason' in request.resource.data) ||
              request.resource.data.conflictReason in ['INSUFFICIENT_STOCK', 'PRODUCT_NOT_FOUND', 'PRODUCT_CHANGED']);
        allow delete: if userOwnsResource(uid);
      }

      // SUBCOLLECTION: mercadopago_connections
      // User can read their own MP connections
      // Writes are backend-only (OAuth flow)
      match /mercadopago_connections/{connectionId} {
        allow read: if userOwnsResource(uid);
        allow create, update, delete: if false;
      }
    }
    
    // ===== ROOT LEVEL: /user_settings/{userId} =====
    // User settings should be managed by backend API only
    // No direct client access
    match /user_settings/{userId} {
      allow read, write: if false;
    }
    
    // ===== ROOT LEVEL: /admin_users/{userId} =====
    // Admin user metadata - no direct client access
    match /admin_users/{userId} {
      allow read, write: if false;
    }
    
    // ===== ROOT LEVEL: /mercadopago_oauth_states/{nonce} =====
    // OAuth state nonces - server-side only
    // Used during OAuth callback flow (backend validation)
    match /mercadopago_oauth_states/{nonce} {
      allow read, write: if false;
    }

    // Server-owned deletion tombstones. Besides being unreadable to clients, their
    // existence makes userOwnsResource fail for ID tokens issued before deletion.
    match /account_deletion_requests/{uid} {
      allow read, write: if false;
    }
    
    // ===== DEFAULT: Deny all other paths =====
    // Explicit deny for any path not explicitly allowed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
